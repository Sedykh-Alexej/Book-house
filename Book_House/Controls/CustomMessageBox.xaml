<Window x:Class="Book_House.Controls.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Уведомление системы" SizeToContent="WidthAndHeight" MaxWidth="700" MaxHeight="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow" ShowInTaskbar="False">
    <Border CornerRadius="8" Background="White" Padding="12" BorderBrush="#FFCCCCCC" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Style="{DynamicResource CustomFont}" HorizontalAlignment="Left" FontWeight="Bold" FontSize="16"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                <Image x:Name="IconImage" Width="48" Height="48" Margin="0,0,12,0" Visibility="Collapsed"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Foreground="#222" />
                </ScrollViewer>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Btn1" Style="{DynamicResource ButtonStyle}" Width="90" Height="30" Margin="6" Click="Btn_Click"/>
                <Button x:Name="Btn2" Style="{DynamicResource ButtonStyle}" Width="90" Height="30" Margin="6" Click="Btn_Click" Visibility="Collapsed"/>
                <Button x:Name="Btn3" Style="{DynamicResource ButtonStyle}" Width="90" Height="30" Margin="6" Click="Btn_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
